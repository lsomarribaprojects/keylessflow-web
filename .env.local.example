# =============================================================================
# KeyLess Flow Web — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored by Next.js; never commit secrets.
#
# Variables prefixed NEXT_PUBLIC_* are exposed to the browser.
# Everything else is server-only.

# -----------------------------------------------------------------------------
# Supabase  (https://supabase.com → create project → Settings → API)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...   # bypasses RLS — server only

# -----------------------------------------------------------------------------
# Stripe  (https://dashboard.stripe.com/test/apikeys)
# -----------------------------------------------------------------------------
# Start with TEST keys (sk_test_… / pk_test_…) — switch to live keys at launch.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...                     # from `stripe listen` or webhook settings

# Stripe Price IDs (created in dashboard → Products → New).
# Pro plan: $9.99/mo  →  price_xxx (recurring monthly)
# Team plan: $29/mo (5 users)  →  price_xxx (recurring monthly)
STRIPE_PRICE_ID_PRO=price_xxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_TEAM=price_xxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Groq  (https://console.groq.com/keys)
# -----------------------------------------------------------------------------
# Sinsajo's master Groq key — server-side proxy uses this to transcribe Pro
# users' audio. Each request goes through usage tracking before billing Groq.
GROQ_API_KEY=gsk_...

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000          # change to https://keylessflow.app in prod
